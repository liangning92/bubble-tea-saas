<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.bubbletea.hermes-employee-gateway</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string><string>-I</string><string>-B</string>
    <string>__SCRIPT__</string><string>--config</string><string>__CONFIG__</string>
  </array>
  <key>WorkingDirectory</key><string>__WORKDIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>60</integer>
  <key>StandardOutPath</key><string>__LOGDIR__/gateway.service.log</string>
  <key>StandardErrorPath</key><string>__LOGDIR__/gateway.service.err.log</string>
</dict></plist>
