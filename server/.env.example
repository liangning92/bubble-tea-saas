# Server Environment Variables
# Copy to .env and fill in your values

NODE_ENV=development
PORT=7072

# Development server uses an isolated PostgreSQL database. Desktop packaging uses schema.sqlite.prisma.
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/bubble_tea_dev"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/database"

# Configure secrets in your deployment environment; keep these values empty in the example file.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
BOOTSTRAP_SECRET=""
XENDIT_CALLBACK_TOKEN=""

CORS_ORIGIN="http://localhost:5173"

API_BASE_URL="https://api.aicube.online"
REDIS_URL=""
