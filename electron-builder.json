{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bubbletea.pos",
  "productName": "BubbleTeaPOS",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "client-pos/dist",
    "client-pos/dist-electron",
    "server/dist",
    "server/prisma/seed.db"
  ],
  "extraMetadata": {
    "main": "client-pos/dist-electron/electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "server/prisma/seed.db",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/client/**/*",
    "node_modules/node-thermal-printer/**/*",
    "node_modules/electron-printer/**/*",
    "node_modules/printer/**/*"
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-Windows-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BubbleTeaPOS",
    "include": "client-pos/installer.nsh"
  },
  "publish": {
    "provider": "generic",
    "url": "https://api.aicube.online/updates/"
  }
}
