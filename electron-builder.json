{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bubbletea.pos",
  "productName": "BubbleTeaPOS",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "server/dist/**/*",
    "server/node_modules/**/*",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/client/**/*",
    "server/prisma/schema.prisma",
    "server/prisma/seed.db",
    "client-pos/dist/**/*",
    "client-pos/dist-electron/**/*",
    "dist-electron/**/*",
    "shared/**/*",
    "!**/node_modules/.cache/**/*"
  ],
  "extraMetadata": {
    "main": "client-pos/dist-electron/electron/main.js"
  },
  "asar": false,
  "asarUnpack": [
    "**/*.node",
    "server/prisma/seed.db",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/client/**/*"
  ],
  "npmRebuild": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-Windows-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BubbleTeaPOS"
  }
}
