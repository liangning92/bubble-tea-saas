{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bubbletea.pos",
  "productName": "BTPS",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "server/uploads/**/*",
    "server/prisma/schema.prisma",
    "server/prisma/dev.db",
    "server/prisma/seed.db",
    "client-pos/dist/**/*",
    "client-pos/dist-electron/**/*",
    "shared/**/*",
    "!**/*.map",
    "!**/node_modules/.cache/**/*",
    "!**/node_modules/**/printer/**/*",
    "!**/node_modules/**/node-thermal-printer/**/*"
  ],
  "extraResources": [
    {
      "from": "server/dist",
      "to": "app.asar.unpacked/server/dist",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "server/node_modules",
      "to": "app.asar.unpacked/node_modules",
      "filter": [
        "**/*"
      ]
    }
  ],
  "extraMetadata": {
    "main": "client-pos/dist-electron/electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "/**/*.node",
    "node_modules/.prisma/client/libquery_engine-*.node"
  ],
  "npmRebuild": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-Windows-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BTPS",
    "include": "client-pos/installer.nsh",
    "unicode": true
  }
}