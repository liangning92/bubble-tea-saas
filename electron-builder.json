{
  "appId": "com.bubbletea.pos",
  "productName": "BubbleTeaPOS",
  "artifactName": "${productName}.${ext}",
  "electronVersion": "28.3.3",
  "app": "client-pos",
  "directories": {
    "output": "client-pos/release"
  },
  "npmRebuild": false,
  "files": [
    "client-pos/dist/**/*",
    "client-pos/dist-electron/**/*",
    "server/dist/**/*",
    "server/prisma/seed.db",
    "client-pos/node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "client-pos/dist-electron/electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "server/prisma/seed.db"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": true,
    "include": "client-pos/installer.nsh",
    "guid": "7d0ef5b8-459f-4c20-a9ca-64d072057da3"
  },
  "publish": {
    "provider": "github",
    "owner": "liangning92",
    "repo": "bubble-tea-saas"
  }
}
