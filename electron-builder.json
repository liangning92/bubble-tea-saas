      "to": "@prisma/client",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/.prisma/client",
      "to": ".prisma/client",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/electron-log",
      "to": "electron-log",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/electron-updater",
      "to": "electron-updater",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "main": "client-pos/dist-electron/electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "server/prisma/seed.db"
  ],
  "npmRebuild": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-Windows-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BubbleTeaPOS",
    "include": "client-pos/installer.nsh"
  }
}
