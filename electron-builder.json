{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bubbletea.pos",
  "productName": "BTPS",
  "electronVersion": "33.4.11",
  "publish": [
    {
      "provider": "github",
      "owner": "liangning92",
      "repo": "bubble-tea-saas",
      "releaseType": "release",
      "vPrefixedTagName": false
    }
  ],
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "server/uploads/**/*",
    "client-pos/node_modules/electron-pos-printer/**/*",
    "server/node_modules/**/*",
    "client-pos/dist/**/*",
    "client-pos/dist-electron/**/*",
    "client-admin/dist/**/*",
    "shared/**/*",
    "!**/*.map",
    "!**/node_modules/.cache/**/*",
    "!**/node_modules/**/node-thermal-printer/**/*"
  ],
  "extraResources": [
    {
      "from": "server/dist",
      "to": "app.asar.unpacked/server/dist",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "server/node_modules",
      "to": "app.asar.unpacked/server/node_modules",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "server/uploads",
      "to": "app.asar.unpacked/server/uploads",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "server/prisma",
      "to": "app.asar.unpacked/server/prisma",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "node_modules/.prisma",
      "to": "app.asar.unpacked/node_modules/.prisma",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "node_modules/@prisma/client",
      "to": "app.asar.unpacked/node_modules/@prisma/client",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "client-pos/node_modules/electron-pos-printer",
      "to": "app.asar.unpacked/node_modules/electron-pos-printer",
      "filter": [
        "**/*"
      ]
    }
  ],
  "extraMetadata": {
    "main": "client-pos/dist-electron/electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "node_modules/.prisma/client/**/*",
    "node_modules/@prisma/client/**/*",
    "client-pos/node_modules/electron-pos-printer/**/*",
    "server/node_modules/**/*",
    "client-pos/dist-electron/**/*"
  ],
  "npmRebuild": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-Windows-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BTPS",
    "include": "client-pos/installer.nsh",
    "unicode": true
  }
}
