{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bubbletea.pos",
  "productName": "BubbleTeaPOS",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "server/dist/**/*",
    "server/uploads/**/*",
    "server/prisma/schema.prisma",
    "server/prisma/seed.db",
    "client-pos/dist/**/*",
    "client-pos/dist-electron/**/*",
    "dist-electron/**/*",
    "shared/**/*",
    "!**/*.map",
    "!**/node_modules/.cache/**/*",
    "!**/node_modules/**/printer/**/*",
    "!**/node_modules/**/node-thermal-printer/**/*",
    {
      "from": "node_modules",
      "to": "node_modules",
      "filter": [
        "**/*",
        "express/**/*",
        "cors/**/*",
        "socket.io/**/*",
        "helmet/**/*",
        "jsonwebtoken/**/*",
        "morgan/**/*",
        "multer/**/*",
        "bcryptjs/**/*",
        "zod/**/*",
        "date-fns/**/*",
        "xlsx/**/*",
        "uuid/**/*",
        "dotenv/**/*",
        "express-validator/**/*",
        "express-rate-limit/**/*",
        "@prisma/client/**/*",
        ".prisma/**/*"
      ]
    }
  ],
  "extraMetadata": {
    "main": "client-pos/dist-electron/electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "server/prisma/seed.db",
    "/server/dist/**/*",
    "/node_modules/express/**/*",
    "/node_modules/cors/**/*",
    "/node_modules/socket.io/**/*",
    "/node_modules/helmet/**/*",
    "/node_modules/jsonwebtoken/**/*",
    "/node_modules/morgan/**/*",
    "/node_modules/multer/**/*",
    "/node_modules/bcryptjs/**/*",
    "/node_modules/zod/**/*",
    "/node_modules/date-fns/**/*",
    "/node_modules/xlsx/**/*",
    "/node_modules/uuid/**/*",
    "/node_modules/dotenv/**/*",
    "/node_modules/express-validator/**/*",
    "/node_modules/express-rate-limit/**/*",
    "/node_modules/.prisma/**/*",
    "/node_modules/@prisma/client/**/*",
    "/node_modules/electron-log/**/*",
    "/node_modules/electron-updater/**/*",
    "/node_modules/electron-printer/**/*"
  ],
  "npmRebuild": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-Windows-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BubbleTeaPOS",
    "include": "client-pos/installer.nsh"
  }
}
