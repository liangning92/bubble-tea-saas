@@ -0,0 +1,14 @@
+import type { LocalOrder } from '../db/offline'
+/** Preserve the original request across transport retry; mutable display totals are not a replacement. */
+export function orderSyncPayload(order: LocalOrder) {
+  if (order.checkoutRequest) return { ...order.checkoutRequest, shiftSessionId: order.shiftSessionId }
+  // Legacy queues have no complete original snapshot; server may require review.
+  return {
+    storeId:order.storeId,staffId:order.staffId,shiftSessionId:order.shiftSessionId,
+    channelId:order.channelId || 'POS',memberId:order.memberId,items:order.items,
+    discountAmount:order.discountAmount,paymentMethod:order.paymentMethod,
+    qrisExternalId:order.qrisExternalId,paymentEvidenceId:order.paymentEvidenceId,
+    taxEnabled:order.taxEnabled,pointsRedeemed:order.pointsRedeemed,
+    orderNumber:order.orderNumber,pickupNumber:order.pickupNumber,customerCount:order.customerCount || 1
+  }
+}
