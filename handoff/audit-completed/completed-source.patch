diff --git a/client-admin/src/components/PaymentEvidencePanel.tsx b/client-admin/src/components/PaymentEvidencePanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3927c396e25552b5a514aecd9d3171dcdb5ad1a0
--- /dev/null
+++ b/client-admin/src/components/PaymentEvidencePanel.tsx
@@ -0,0 +1,25 @@
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import api from '../services/api'
+import { formatCurrency, formatDateTime } from '../utils/helpers'
+export function PaymentEvidencePanel({ orderId }: { orderId: string }) {
+  const { t } = useTranslation()
+  const { data } = useQuery({ queryKey: ['payment-evidence', orderId], queryFn: async () => {
+    try { return (await api.get(`/payments/order/${orderId}/evidence`)).data.data } catch (error: any) { if (error.response?.status === 404) return null; throw error }
+  }, retry: false })
+  if (!data) return <p className="text-sm text-gray-500">{t('manualPayment.absent')}</p>
+  const download = async () => {
+    try {
+      const response = await api.get(`/payments/evidence/${data.id}`, { responseType: 'blob' })
+      const url = URL.createObjectURL(response.data); const link = document.createElement('a')
+      link.href = url; link.download = `payment-evidence-${data.id}`; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000)
+    } catch { alert(t('common.error')) }
+  }
+  return <div className="mt-4 p-3 border rounded-lg text-sm space-y-1">
+    <p>{t('manualPayment.evidenceOnly')}</p>
+    <p>{t('manualPayment.amount')}: {formatCurrency(data.amount)}</p>
+    <p>{t('manualPayment.actor')}: {data.confirmedBy}</p>
+    <p>{t('manualPayment.time')}: {data.confirmedAt ? formatDateTime(data.confirmedAt) : '—'}</p>
+    <button type="button" className="text-primary underline" onClick={download}>{t('manualPayment.view')}</button>
+  </div>
+}
diff --git a/client-admin/src/components/RefundPolicyReview.tsx b/client-admin/src/components/RefundPolicyReview.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1a14de955b78a39a5e2a1f9a45fee319cd16103a
--- /dev/null
+++ b/client-admin/src/components/RefundPolicyReview.tsx
@@ -0,0 +1,16 @@
+import { useTranslation } from 'react-i18next'
+interface RequestPolicy {reasonCode?:string;selectedItemIds?:string;order?:{items:any[]}}
+export function confirmPreparedRefund(request:RequestPolicy,t:(key:string)=>string):boolean {
+ if(!['customer_dissatisfied','paid_unprepared'].includes(request.reasonCode||'')){alert(t(request.reasonCode==='paid_unprepared'?'refundPolicy.unpreparedBlocked':'refundPolicy.legacyBlocked'));return false}
+ let ids:string[]=[];try{ids=JSON.parse(request.selectedItemIds||'[]')}catch{}
+ if(!request.order?.items?.length||ids.length!==request.order.items.length){alert(t('refundPolicy.partialBlocked'));return false}
+ return window.confirm(t(request.reasonCode==='paid_unprepared'?'refundPolicy.verifyUnprepared':'refundPolicy.verifyPrepared'))
+}
+export function RefundPolicyReview({request}:{request:RequestPolicy}){
+ const {t}=useTranslation();let ids:string[]=[];try{ids=JSON.parse(request.selectedItemIds||'[]')}catch{}
+ return <div className="my-3 p-3 border rounded text-sm space-y-1">
+  <p>{t(`refundPolicy.${request.reasonCode||'legacy'}`)}</p>
+  <p>{t('refundPolicy.selected')}: {request.order?.items?.filter(item=>ids.includes(item.id)).map(item=>`${item.quantity} × ${item.productName}`).join(', ')||'—'}</p>
+  <p className="text-amber-700">{t(request.reasonCode==='paid_unprepared'?'refundPolicy.unpreparedBlocked':'refundPolicy.noRestock')}</p>
+ </div>
+}
