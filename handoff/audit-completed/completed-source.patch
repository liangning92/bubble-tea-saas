@@ -0,0 +1,20 @@
+import { createHash } from 'crypto'
+import type { CreateOrderData } from '../services/OrderService'
+import { canonical } from './orderSnapshot'
+/** Hash only accepted, behavior-affecting input; never current catalog/balance or caller identity. */
+export function orderRequestFingerprint(data: CreateOrderData): string {
+  const pickupNumber = data.pickupNumber || (data.orderNumber && /^[A-Z]\d{2,4}$/i.test(data.orderNumber) ? data.orderNumber : null)
+  const request = {
+    orderNumber:data.orderNumber && !/^[A-Z]\d{2,4}$/i.test(data.orderNumber) ? data.orderNumber : null,
+    storeId:data.storeId, staffId:data.staffId, memberId:data.memberId ?? null,
+    channelId:data.channelId ?? null, paymentMethod:data.paymentMethod,
+    discountAmount:data.discountAmount ?? 0, pointsRedeemed:data.pointsRedeemed ?? 0,
+    taxEnabled:data.taxEnabled !== false, status:data.status ?? 'completed', customerCount:data.customerCount || 1,
+    pickupNumber, platformOrderId:data.platformOrderId ?? null, tableNumber:data.tableNumber ?? null,
+    callerPhone:data.callerPhone ?? null, driverPickupTime:data.driverPickupTime ? new Date(data.driverPickupTime).toISOString() : null,
+    purchaseOrderNo:data.purchaseOrderNo ?? null, socialRef:data.socialRef ?? null, note:data.note ?? null,
+    qrisExternalId:data.qrisExternalId ?? null, paymentEvidenceId:data.paymentEvidenceId ?? null,
+    items:data.items.map(item=>canonical({...item,addons:item.addons ?? []})).sort()
+  }
+  return 'v1:'+createHash('sha256').update(canonical(request)).digest('hex')
+}
diff --git a/server/src/utils/orderSnapshot.ts b/server/src/utils/orderSnapshot.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8e90143ad4450e9d1768e066732d32de76ea81ce
--- /dev/null
+++ b/server/src/utils/orderSnapshot.ts
@@ -0,0 +1,31 @@
+// Compare immutable synced receipts without relying on object key or line order.
+export function canonical(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`
+  if (value && typeof value === 'object') {
+    const record = value as Record<string, unknown>
+    return `{${Object.keys(record).sort().map(key => `${JSON.stringify(key)}:${canonical(record[key])}`).join(',')}}`
+  }
+  return JSON.stringify(value ?? null)
+}
+function addons(value: unknown): unknown {
+  if (typeof value !== 'string') return value ?? []
+  try { return JSON.parse(value) } catch { return value }
+}
+export function orderSnapshot(order: Record<string, unknown>): string {
+  const pick = (keys: string[]) => Object.fromEntries(keys.map(key => [key, order[key] ?? null]))
+  return canonical({
+    ...pick(['storeId','orderNumber','staffId','memberId','channelId','paymentMethod','totalAmount','finalAmount']),
+    status: order.status ?? 'completed', discountAmount: order.discountAmount ?? 0,
+    customerCount: order.customerCount ?? 1,
+    items: (Array.isArray(order.items) ? order.items : []).map((item: Record<string, unknown>) => canonical({
+      productId:item.productId, productName:item.productName, specId:item.specId,
+      specName:item.specName, quantity:item.quantity, unitPrice:item.unitPrice,
+      addons:addons(item.addons), bomCost:item.bomCost ?? 0
+    })).sort()
+  })
+}
+
+export function saleLines(items: Array<{ productId: string; specId?: string; quantity: number; unitPrice: number; addons?: unknown }>): string {
+  return canonical(items.map(item => canonical({ productId: item.productId, specId: item.specId ?? null,
+    quantity: item.quantity, unitPrice: item.unitPrice, addons: addons(item.addons) })).sort())
+}
