{
  "name": "bubble-tea-pos",
  "private": true,
  "version": "2.0.6",
  "description": "Bubble Tea POS System",
  "author": "Bubble Tea Team",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --port 6063",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:electron": "npm run build:electron:main && electron .",
    "build:electron:main": "tsc -p tsconfig.electron.json",
    "build:electron": "npm run build && npm run build:electron:main && electron-builder --win portable",
    "build:electron:installer": "npm run build && npm run build:electron:main && electron-builder --win nsis"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.6.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "esbuild": "^0.28.1",
    "i18next": "^23.8.0",
    "lucide-react": "^0.312.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.bubbletea.pos",
    "productName": "BubbleTeaPOS",
    "artifactName": "${productName}.${ext}",
    "electronVersion": "28.3.3",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh",
      "guid": "7d0ef5b8-459f-4c20-a9ca-64d072057da3"
    }
  }
}
